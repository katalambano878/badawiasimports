# Badawias Imports — environment template (no secrets)

# --- Core ---
NEXT_PUBLIC_APP_URL=https://www.badawiasimports.com
NEXT_PUBLIC_SITE_NAME=Badawias Imports
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/badawiasimports
POSTGRES_URL=
PG_POOL_MAX=10
PGSSL=
NEXT_PUBLIC_USE_PLAIN_PG=true

# App auth keys (NOT hosted Supabase)
# Dual-read still accepts NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY during cutover.
NEXT_PUBLIC_APP_ANON_KEY=replace-with-public-anon-or-app-key
APP_SERVICE_KEY=replace-with-server-service-key
AUTH_JWT_SECRET=replace-with-long-random-secret
JWT_SECRET=

# Deprecated aliases (optional during cutover — remove after Coolify updated)
# NEXT_PUBLIC_SUPABASE_URL=https://www.badawiasimports.com
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Local disk storage
STORAGE_ROOT=/app/storage
STORAGE_PUBLIC_URL=
STORAGE_SIGNING_SECRET=

# Email / SMS
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=
MOOLRE_SMS_API_KEY=
MOOLRE_API_KEY=
SMS_SENDER_ID=Badawias

# Moolre payments
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_CALLBACK_SECRET=

# Paystack / Stripe / PayPal
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=ghs
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.paypal.com
PAYPAL_CURRENCY=GHS

# Security / cron / admin bootstrap
CRON_SECRET=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
CREATE_ADMIN_EMAIL=
CREATE_ADMIN_PASSWORD=
SET_ADMIN_EMAIL=

# Storefront public
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
